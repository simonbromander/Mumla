require "base64"
require "digest"
require "fileutils"
require "json"
require "open3"
require "openssl"
require "shellwords"
require_relative "direct_signing"

default_platform(:ios)

ROOT = File.expand_path("..", __dir__)
PROJECT = File.join(ROOT, "Mumla.xcodeproj")
SCHEME = "Mumla"
MAC_SCHEME = "MumlaMac"
BUNDLE_ID = "com.mumla.app"
TEAM_ID = "PF2PWR4YG4"
VERSION = "1.0.1"
OUTPUT = File.join(ROOT, ".build", "TestFlight")
MAC_OUTPUT = File.join(ROOT, ".build", "TestFlightMac")
DIRECT_OUTPUT = File.join(ROOT, ".build", "DirectMac")

def require_env!(names)
  missing = names.select { |name| ENV[name].to_s.strip.empty? }
  UI.user_error!("Missing required environment variables: #{missing.join(", ")}") unless missing.empty?
end

def mumla_api_key
  require_env!(%w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH])
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
    duration: 1200,
    in_house: false
  )
end

def mumla_context
  api_key = mumla_api_key
  identities, error, status = Open3.capture3("security", "find-identity", "-v", "-p", "codesigning")
  UI.user_error!("Cannot inspect local signing identities: #{error}") unless status.success?

  teams = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: "DISTRIBUTION" }).filter_map do |certificate|
    cert = OpenSSL::X509::Certificate.new(Base64.decode64(certificate.certificate_content))
    fingerprint = Digest::SHA1.hexdigest(cert.to_der).upcase
    next unless cert.not_after > Time.now && identities.include?(fingerprint)
    cert.subject.to_a.find { |entry| entry[0] == "OU" }&.at(1)
  end.uniq

  UI.user_error!("No unexpired API-team distribution certificate with a local private key was found.") unless teams.include?(TEAM_ID)

  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
  UI.success("API authentication and local distribution identity verified. Team: #{TEAM_ID}")
  UI.message(app ? "App Store Connect record found for #{BUNDLE_ID}." : "No App Store Connect app record exists for #{BUNDLE_ID} yet.")

  { api_key: api_key, app: app }
end

platform :ios do
  desc "Publish and verify localized testing notes for one explicitly selected build"
  lane :beta_notes do |options|
    UI.user_error!("Pass file:path to the versioned testing-notes JSON.") unless options[:file]
    notes = JSON.parse(File.read(File.expand_path(options[:file], ROOT)))
    context = mumla_context
    UI.user_error!("The App Store Connect record is missing.") unless context[:app]
    builds = context[:app].get_builds(filter: { "preReleaseVersion.version" => notes.fetch("version"), version: notes.fetch("build") }, includes: "preReleaseVersion")
    matches = builds.select { |build| build.platform == notes.fetch("platform") }
    UI.user_error!("Expected exactly one matching build.") unless matches.length == 1
    build = matches.first
    localizations = build.get_beta_build_localizations
    notes.fetch("localizations").each do |locale, text|
      existing = localizations.find { |item| item.locale == locale }
      if existing
        Spaceship::ConnectAPI.patch_beta_build_localizations(localization_id: existing.id, attributes: { whatsNew: text })
      else
        Spaceship::ConnectAPI.post_beta_build_localizations(build_id: build.id, attributes: { locale: locale, whatsNew: text })
      end
    end
    verified = build.get_beta_build_localizations.to_h { |item| [item.locale, item.whats_new] }
    notes.fetch("localizations").each do |locale, text|
      UI.user_error!("Testing notes did not match for #{locale}.") unless verified[locale] == text
    end
    UI.success("Testing notes verified for #{build.platform} #{build.app_version} (#{build.version}), #{build.id}.")
  end

  desc "Read-only TestFlight status for both platforms and the existing internal audience"
  lane :beta_status do
    context = mumla_context
    UI.user_error!("The App Store Connect record is missing.") unless context[:app]
    app = context[:app]
    builds = app.get_builds(filter: { "preReleaseVersion.version" => VERSION }, includes: "preReleaseVersion,buildBetaDetail", sort: "-uploadedDate")
    groups = app.get_beta_groups.select(&:is_internal_group)
    report = {
      checked_at: Time.now.utc.iso8601,
      app_id: app.id,
      bundle_id: BUNDLE_ID,
      builds: builds.map do |build|
        {
          id: build.id, platform: build.platform, version: build.app_version,
          build: build.version, processing: build.processing_state,
          internal: build.build_beta_detail&.internal_build_state,
          external: build.build_beta_detail&.external_build_state
        }
      end,
      internal_groups: groups.map do |group|
        { name: group.name, all_builds: group.has_access_to_all_builds, build_ids: group.fetch_builds.map(&:id) }
      end
    }
    FileUtils.mkdir_p(File.join(ROOT, ".build"))
    File.write(File.join(ROOT, ".build", "testflight-status.json"), JSON.pretty_generate(report))
    UI.message(JSON.pretty_generate(report))
  end

  desc "Read-only release preflight: generate project, build simulator, verify ASC app record/signing context"
  lane :preflight do
    sh("xcodegen", "generate", "--spec", File.join(ROOT, "project.yml"))
    sh([
      "xcodebuild",
      "-project", Shellwords.escape(PROJECT),
      "-scheme", Shellwords.escape(SCHEME),
      "-configuration", "Release",
      "-destination", "'generic/platform=iOS Simulator'",
      "CODE_SIGNING_ALLOWED=NO",
      "build"
    ].join(" "))
    mumla_context
    UI.success("Read-only preflight finished.")
  end

  desc "Create a signed App Store/TestFlight IPA without uploading"
  lane :build do
    context = mumla_context
    FileUtils.mkdir_p(OUTPUT)
    sh("xcodegen", "generate", "--spec", File.join(ROOT, "project.yml"))

    next_build = if context[:app]
      latest_testflight_build_number(
        api_key: context[:api_key],
        app_identifier: BUNDLE_ID,
        version: VERSION,
        initial_build_number: 21
      ) + 1
    else
      16
    end

    auth = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", File.expand_path(ENV.fetch("ASC_KEY_PATH")),
      "-authenticationKeyID", ENV.fetch("ASC_KEY_ID"),
      "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID")
    ].shelljoin
    settings = [
      "DEVELOPMENT_TEAM=#{TEAM_ID}",
      "PRODUCT_BUNDLE_IDENTIFIER=#{BUNDLE_ID}",
      "MARKETING_VERSION=#{VERSION}",
      "CURRENT_PROJECT_VERSION=#{next_build}",
      "CODE_SIGN_STYLE=Automatic"
    ].shelljoin

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      archive_path: File.join(ROOT, ".build", "Mumla-fastlane.xcarchive"),
      output_directory: OUTPUT,
      output_name: "Mumla.ipa",
      buildlog_path: File.join(ROOT, ".build", "fastlane-logs"),
      skip_profile_detection: true,
      export_method: "app-store",
      export_options: {
        method: "app-store-connect",
        signingStyle: "automatic",
        teamID: TEAM_ID,
        manageAppVersionAndBuildNumber: false,
        uploadSymbols: true
      },
      xcargs: "#{auth} #{settings}"
    )
  end

  desc "Upload an existing signed IPA to TestFlight"
  lane :upload do
    context = mumla_context
    UI.user_error!("Create the matching App Store Connect app record before upload.") unless context[:app]

    ipa = File.join(OUTPUT, "Mumla.ipa")
    UI.user_error!("Build the signed IPA first.") unless File.file?(ipa)
    identifier = get_ipa_info_plist_value(ipa: ipa, key: "CFBundleIdentifier")
    UI.user_error!("The signed IPA bundle ID does not match #{BUNDLE_ID}.") unless identifier == BUNDLE_ID

    upload_to_testflight(
      api_key: context[:api_key],
      app_identifier: BUNDLE_ID,
      ipa: ipa,
      skip_waiting_for_build_processing: false,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false
    )
    UI.success("Upload processing completed. Assign the build only to intended internal testers.")
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    build
    upload
  end

  desc "Read-only macOS release preflight: generate project, build macOS release, verify ASC app record/signing context"
  lane :mac_preflight do
    sh("xcodegen", "generate", "--spec", File.join(ROOT, "project.yml"))
    sh([
      "xcodebuild",
      "-project", Shellwords.escape(PROJECT),
      "-scheme", Shellwords.escape(MAC_SCHEME),
      "-configuration", "Release",
      "-destination", "'generic/platform=macOS'",
      "CODE_SIGNING_ALLOWED=NO",
      "build"
    ].join(" "))
    mumla_context
    UI.message("macOS TestFlight upload uses the existing App Store Connect app record for #{BUNDLE_ID}.")
    UI.success("Read-only macOS preflight finished.")
  end

  desc "Create a signed macOS App Store/TestFlight package without uploading"
  lane :mac_build do
    context = mumla_context
    FileUtils.mkdir_p(MAC_OUTPUT)
    sh("xcodegen", "generate", "--spec", File.join(ROOT, "project.yml"))

    next_build = latest_testflight_build_number(
      api_key: context[:api_key],
      app_identifier: BUNDLE_ID,
      version: VERSION,
      platform: "osx",
      initial_build_number: 24
    ) + 1

    auth = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", File.expand_path(ENV.fetch("ASC_KEY_PATH")),
      "-authenticationKeyID", ENV.fetch("ASC_KEY_ID"),
      "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID")
    ].shelljoin
    settings = [
      "DEVELOPMENT_TEAM=#{TEAM_ID}",
      "PRODUCT_BUNDLE_IDENTIFIER=#{BUNDLE_ID}",
      "MARKETING_VERSION=#{VERSION}",
      "CURRENT_PROJECT_VERSION=#{next_build}",
      "CODE_SIGN_STYLE=Automatic"
    ].shelljoin

    build_app(
      project: PROJECT,
      scheme: MAC_SCHEME,
      configuration: "Release",
      clean: true,
      archive_path: File.join(ROOT, ".build", "MumlaMac-fastlane.xcarchive"),
      output_directory: MAC_OUTPUT,
      output_name: "Mumla",
      buildlog_path: File.join(ROOT, ".build", "fastlane-logs"),
      skip_profile_detection: true,
      export_method: "app-store",
      export_options: {
        method: "app-store-connect",
        signingStyle: "automatic",
        teamID: TEAM_ID,
        manageAppVersionAndBuildNumber: false,
        uploadSymbols: true
      },
      destination: "generic/platform=macOS",
      xcargs: "#{auth} #{settings}"
    )
  end

  desc "Upload an existing signed macOS package to TestFlight"
  lane :mac_upload do
    context = mumla_context
    UI.user_error!("Create the matching App Store Connect app record before upload.") unless context[:app]

    pkg = File.join(MAC_OUTPUT, "Mumla.pkg")
    UI.user_error!("Build the signed macOS package first.") unless File.file?(pkg)

    upload_to_testflight(
      api_key: context[:api_key],
      app_identifier: BUNDLE_ID,
      app_platform: "osx",
      pkg: pkg,
      skip_waiting_for_build_processing: false,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false
    )
    UI.success("macOS upload processing completed. Assign the build only to intended internal testers.")
  end

  desc "Build and upload the macOS app to TestFlight"
  lane :mac_beta do
    mac_build
    mac_upload
  end

  desc "Create the full-capability Mac app signed with Developer ID, without publishing"
  lane :mac_direct_build do |options|
    begin
      signing_identity = MumlaDirectSigning.identity(team_id: TEAM_ID)
    rescue MumlaDirectSigning::Error => error
      UI.user_error!(error.message)
    end
    FileUtils.mkdir_p(DIRECT_OUTPUT)
    sh("xcodegen", "generate", "--spec", File.join(ROOT, "project.yml"))
    build_number = Integer(options[:build] || 32)
    UI.user_error!("Build number must be positive.") unless build_number.positive?
    build_app(
      project: PROJECT,
      scheme: "MumlaMacDirect",
      configuration: "Direct",
      archive_path: File.join(ROOT, ".build", "MumlaMac-direct.xcarchive"),
      output_directory: DIRECT_OUTPUT,
      output_name: "Mumla",
      buildlog_path: File.join(ROOT, ".build", "fastlane-logs"),
      skip_profile_detection: true,
      skip_package_pkg: true,
      export_method: "developer-id",
      export_options: {
        method: "developer-id",
        signingStyle: "manual",
        signingCertificate: signing_identity,
        teamID: TEAM_ID
      },
      destination: "generic/platform=macOS",
      xcargs: ["DEVELOPMENT_TEAM=#{TEAM_ID}", "CURRENT_PROJECT_VERSION=#{build_number}",
               "CODE_SIGN_STYLE=Manual", "CODE_SIGN_IDENTITY=#{signing_identity}"].shelljoin
    )
    app = File.join(DIRECT_OUTPUT, "Mumla.app")
    UI.user_error!("The direct app was not produced.") unless File.directory?(app)
    sh("codesign", "--verify", "--deep", "--strict", "--verbose=2", app)
    entitlements, error, status = Open3.capture3("codesign", "-d", "--entitlements", ":-", app)
    UI.user_error!("Cannot read direct app entitlements: #{error}") unless status.success?
    UI.user_error!("The direct app must not be sandboxed.") if entitlements.include?("com.apple.security.app-sandbox")
    # codesign writes signature details to stderr.
    _, signature, = Open3.capture3("codesign", "-dv", "--verbose=4", app)
    UI.user_error!("Expected this team's Developer ID Application signature.") unless signature.include?("Authority=Developer ID Application:") && signature.include?("TeamIdentifier=#{TEAM_ID}")
    UI.success("Direct Mac build created. Notarization and runtime acceptance are still separate steps.")
  end

  desc "Notarize and staple the existing direct Mac app, then produce an installable ZIP"
  lane :mac_direct_notarize do
    require_env!(%w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH])
    app = File.join(DIRECT_OUTPUT, "Mumla.app")
    UI.user_error!("Run mac_direct_build first.") unless File.directory?(app)
    sh("codesign", "--verify", "--deep", "--strict", "--verbose=2", app)
    info = JSON.parse(sh("plutil", "-convert", "json", "-o", "-", File.join(app, "Contents", "Info.plist"), log: false))
    zip = File.join(DIRECT_OUTPUT, "Mumla-#{info.fetch("CFBundleShortVersionString")}-#{info.fetch("CFBundleVersion")}.zip")
    FileUtils.rm_f(zip)
    sh("ditto", "-c", "-k", "--keepParent", app, zip)
    response = sh("xcrun", "notarytool", "submit", zip,
                  "--key", File.expand_path(ENV.fetch("ASC_KEY_PATH")),
                  "--key-id", ENV.fetch("ASC_KEY_ID"), "--issuer", ENV.fetch("ASC_ISSUER_ID"),
                  "--wait", "--output-format", "json", log: false)
    report = JSON.parse(response)
    File.write(File.join(DIRECT_OUTPUT, "notarization.json"), JSON.pretty_generate(report))
    UI.user_error!("Notarization was not accepted; inspect .build/DirectMac/notarization.json.") unless report["status"] == "Accepted"
    sh("xcrun", "stapler", "staple", app)
    sh("xcrun", "stapler", "validate", app)
    sh("spctl", "--assess", "--type", "execute", "--verbose=2", app)
    FileUtils.rm_f(zip)
    sh("ditto", "-c", "-k", "--keepParent", app, zip)
    UI.success("Notarized direct Mac ZIP ready: #{zip}")
  end
end
